{
  "name": "black-link-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Black Link API: Express + MongoDB (Mongoose) + Clerk.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "db:memory": "node scripts/memory-db.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:reset": "node --env-file-if-exists=.env scripts/seed.js --reset",
    "export:mock": "node scripts/export-mock-data.mjs",
    "smoke": "node scripts/smoke.js",
    "smoke:auth": "node --env-file-if-exists=.env scripts/smoke-auth.js",
    "smoke:business": "node --env-file-if-exists=.env scripts/smoke-business.js",
    "check:keys": "node --env-file-if-exists=.env scripts/check-keys.js",
    "smoke:reviews": "node --env-file-if-exists=.env scripts/smoke-reviews.js",
    "smoke:community": "node --env-file-if-exists=.env scripts/smoke-community.js",
    "smoke:notify": "node --env-file-if-exists=.env scripts/smoke-notify.js",
    "email:preview": "node --env-file-if-exists=.env scripts/email-preview.js",
    "smoke:admin": "node --env-file-if-exists=.env scripts/smoke-admin.js",
    "smoke:frontend": "node --env-file-if-exists=.env scripts/smoke-frontend.js"
  },
  "dependencies": {
    "@clerk/express": "^1.4.2",
    "@react-email/components": "^0.0.33",
    "@react-email/render": "^1.0.5",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.1.2",
    "svix": "^1.45.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0"
  }
}
