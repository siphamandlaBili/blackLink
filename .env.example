# Black Link API. Copy to .env and fill in. The server refuses to start if a required value is missing.

# --- Required (Phase 1) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local without installing MongoDB: run `npm run db:memory` and paste the URI it prints.
MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=testset
MONGODB_DB_NAME=blacklink
# The web app's origin. The only origin allowed by CORS.
CLIENT_URL=http://localhost:5173
# Public address of this API (used in email one-click unsubscribe links). Render: https://<service>.onrender.com
API_PUBLIC_URL=http://localhost:4000

# Global rate limit (per IP): RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Required from Phase 2: Clerk (dashboard.clerk.com). Not needed when NODE_ENV=test. ---
# API keys page: publishable key (pk_test_...) and secret key (sk_test_...).
# Webhooks page: add an endpoint, then copy its signing secret (whsec_...).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Phase 5: Cloudinary (console.cloudinary.com > Settings > API keys) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Required from Phase 6: Resend (resend.com) and scheduled jobs ---
# EMAIL_FROM must be on a domain verified in Resend. For testing: "Black Link <onboarding@resend.dev>"
RESEND_API_KEY=
EMAIL_FROM="Black Link <hello@yourdomain.co.za>"
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_SECRET=
